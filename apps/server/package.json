{
  "name": "@v2media/server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/database.ts migrate",
    "db:status": "tsx --env-file-if-exists=.env scripts/database.ts status",
    "db:check": "tsx --env-file-if-exists=.env scripts/database.ts check",
    "db:duplicates": "tsx --env-file-if-exists=.env scripts/database.ts duplicates"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.4",
    "@hono/node-server": "^1.13.7",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.14",
    "pg": "^8.13.1",
    "sharp": "^0.35.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
