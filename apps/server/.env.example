# 默认内嵌 PGlite（无需真实 Postgres）；要连真库设此项
# DATABASE_URL=postgres://user:pass@localhost:5432/v2media
# AI（OpenAI 兼容网关，如 new-api）
AI_BASE_URL=https://v2api.top/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 凭据加密（AES-256-GCM）；生产必须设置
ENCRYPTION_KEY=
# 登录 token 签名
AUTH_SECRET=
# 插件调用服务端时带的静态 token（MVP：登录后下发）
PORT=3000
# 媒体转存到 Cloudflare R2（不设则继续用 /api/media/proxy 实时转发 xhscdn）
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=v2-media
# R2_ACCESS_KEY_ID=<r2 api token id>
# R2_SECRET_ACCESS_KEY=<sha256(token value)>
# 媒体画质档位（free 档压缩存储，pro 档原画质；users.plan 切换）
# MEDIA_IMAGE_MAX_WIDTH=1080
# MEDIA_IMAGE_QUALITY=70
# MEDIA_VIDEO_MAX_BYTES=300000000
# MEDIA_VIDEO_MAX_BYTES_PRO=1000000000
# 对外站点地址（生成给插件的绝对媒体 URL，不设置则用请求 origin）
# PUBLIC_BASE_URL=https://xhs.v2api.top
