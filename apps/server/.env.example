# 默认内嵌 PGlite（无需真实 Postgres）；要连真库设此项
# DATABASE_URL=postgres://user:pass@localhost:5432/v2media
# AI（OpenAI 兼容网关，如 new-api）
AI_BASE_URL=https://v2api.top/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# 凭据加密（AES-256-GCM）；生产必须设置
ENCRYPTION_KEY=
# 登录 token 签名
AUTH_SECRET=
# 插件调用服务端时带的静态 token（MVP：登录后下发）
PORT=3000
