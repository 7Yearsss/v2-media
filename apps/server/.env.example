# 默认隔离 PGlite；local-isolated 检测到 DATABASE_URL 会拒绝启动
V2MEDIA_RUNTIME_MODE=local-isolated
# DATABASE_URL=postgres://user:pass@localhost:5432/v2media
# 连生产进行观察：production-readonly + 专用只读数据库角色（不能用库所有者）
# 服务执行生产任务：production-worker；启动只检查 schema，不自动迁移
# 显式迁移：npm run db:migrate -w @v2media/server；可用 MIGRATION_DATABASE_URL 指定独立迁移角色
# DISABLE_MEDIA_MAINTENANCE=1 仅停维护，不等同只读
# local-isolated 如需真实图片存储，声明独立桶；不得填写生产 v2-media
# LOCAL_R2_BUCKET=v2-media-local-dev
# R2_BUCKET=v2-media-local-dev
# AI（OpenAI 兼容网关，如 new-api）
AI_BASE_URL=https://v2api.top/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
# production-worker 必须设置 64 个 hex 字符的 32 字节密钥
ENCRYPTION_KEY=
# 生产两种模式必须至少 32 字符；不能用开发默认值
AUTH_SECRET=
# 插件调用服务端时带的静态 token（MVP：登录后下发）
PORT=3000
# 媒体转存到 Cloudflare R2（不设则继续用 /api/media/proxy 实时转发 xhscdn）
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=v2-media
# R2_ACCESS_KEY_ID=<r2 api token id>
# R2_SECRET_ACCESS_KEY=<sha256(token value)>
# local-isolated 必须声明专用开发桶；LOCAL_R2_BUCKET 与 R2_BUCKET 完全一致
# LOCAL_R2_BUCKET=v2-media-local-<your-name>
# 生产桶 v2-media 在 local-isolated 一律拒绝，防止隔离库的 GC 删除生产引用
# 媒体画质档位（free 档压缩存储，pro 档原画质；users.plan 切换）
# MEDIA_IMAGE_MAX_WIDTH=1080
# MEDIA_IMAGE_QUALITY=70
# MEDIA_VIDEO_MAX_BYTES=300000000
# MEDIA_VIDEO_MAX_BYTES_PRO=1000000000
# 对外站点地址（生成给插件的绝对媒体 URL，不设置则用请求 origin）
# PUBLIC_BASE_URL=https://xhs.v2api.top
# 图片上传源文件的持久暂存位置默认 DATA_DIR/uploads；部署必须保留该目录
# DATA_DIR=/home/ubuntu/apps/v2-media/apps/server/data
